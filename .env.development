# Development: talk to the API directly on its http endpoint.
#
# The backend now allows this origin (appsettings.Development.json → Cors:AllowedOrigins),
# so cross-origin calls work without the Vite proxy. Port 5030 is the project's own
# http endpoint from Properties/launchSettings.json.
#
# Use the *http* endpoint, not https://localhost:7128 — the dev HTTPS certificate is
# self-signed, and a browser refuses an XHR to it until the cert is trusted.
VITE_API_BASE_URL=http://localhost:5030
# Alternative: leave VITE_API_BASE_URL empty to route through the Vite proxy instead,
# which keeps everything same-origin and needs no CORS at all. This is where the proxy
# forwards /api when you do.
VITE_DEV_API_TARGET=https://tokyo-hill-defensive-depth.trycloudflare.com
