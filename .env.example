# ---------------------------------------------------------------------------
# Production / preview
# ---------------------------------------------------------------------------
# Absolute base URL of the loyalty backend, with no trailing slash. Every call
# is sent to `${VITE_API_BASE_URL}/api/v1/...`.
#
# Leave this EMPTY when the dashboard is served from the same host as the API
# (behind one reverse proxy) — requests are then same-origin and need no CORS.
# Set it only for a cross-origin deployment, which requires the API to enable a
# CORS policy for this dashboard's origin.
VITE_API_BASE_URL=http://localhost:5199

# ---------------------------------------------------------------------------
# Development only (see .env.development)
# ---------------------------------------------------------------------------
# Where `npm run dev` proxies /api. Keeps development same-origin.
VITE_DEV_API_TARGET=http://localhost:5199
